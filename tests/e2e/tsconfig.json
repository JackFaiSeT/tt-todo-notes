{
  "extends": "../../config/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@notes/*": ["../../src/core/notes/*"],
      "@shared/contract/*": ["../../src/shared/contract/*"],
      "@shared/*": ["../../src/shared/*"],
      "@e2e/*": ["./*"],
      "@setup/*": ["../setup/*"],
      "@scripts/*": ["../../scripts/*"]
    },
    "noEmit": true
  },
  "include": ["./**/*.ts", "../../playwright.config.ts"]
}
