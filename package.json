{
  "name": "todo-notes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:generate": "drizzle-kit generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tests/tsconfig.json && tsc -p tests/e2e/tsconfig.json && tsc -p config/tsconfig/tooling.json",
    "lint": "node scripts/checks/lint-repo.mjs --all",
    "format": "pnpm run prettier:repo --write",
    "test": "nuxt prepare && vitest run --project unit --project integration",
    "test:watch": "nuxt prepare && vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint:js": "nuxt prepare && node scripts/checks/lint-js.mjs",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" --allow-empty-input",
    "lint:prettier": "pnpm run prettier:repo --check",
    "prettier:repo": "node scripts/checks/prettier.mjs --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude --cache --cache-location .dev-artifacts/cache/prettier",
    "lint:repo": "node scripts/checks/lint-repo.mjs",
    "lint:fix": "node scripts/checks/lint-repo.mjs --fix",
    "check:comments": "node scripts/checks/check-comments.mjs",
    "check:layers": "node scripts/checks/check-layers.mjs",
    "check:composables": "node scripts/checks/check-composables.mjs",
    "check:reactivity": "node scripts/checks/check-reactivity.mjs",
    "check:to-value": "node scripts/checks/check-to-value.mjs",
    "check:domain-types": "node scripts/checks/check-domain-types.mjs",
    "check:data-contracts": "node scripts/checks/check-data-contracts.mjs",
    "check:test-layout": "node scripts/checks/check-test-layout.mjs",
    "check:listeners": "node scripts/checks/check-listeners.mjs",
    "check:exact-versions": "node scripts/checks/check-exact-versions.mjs",
    "check:dependency-names": "node scripts/checks/check-dependency-names.mjs",
    "check:implements": "node scripts/checks/check-implements.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@pinia/nuxt": "1.0.3",
    "better-sqlite3": "13.2.0",
    "consola": "3.4.2",
    "devalue": "6.0.3",
    "drizzle-orm": "0.45.4",
    "h3": "2.0.8",
    "nuxt": "4.6.4",
    "pinia": "4.1.0",
    "pino": "10.4.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/compat": "2.1.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-config": "1.17.0",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@vitest/eslint-plugin": "1.6.27",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "postcss-html": "2.0.0",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "stylelint": "17.16.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-eslint2": "5.3.0",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  }
}
